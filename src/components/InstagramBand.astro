---
import { SITE } from "../config/site";
---

<div
  class="mt-8 grid gap-6 rounded-lg border p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-center"
  style="border-color: var(--border); background: var(--surface);"
>
  <div>
    <p class="text-xl font-extrabold">قاب‌های سفر این‌جاست؛ کاملش در اینستاگرام</p>
    <p class="mt-2 max-w-2xl" style="color: var(--muted);">
      سفرهایم را سبک نگه می‌دارم؛ چند یادداشت و چند قاب. مجموعه‌ی کامل عکس‌ها در اینستاگرام است،
      با نشانی <span class="ltr font-mono text-sm">{SITE.instagramHandle}</span>.
    </p>
  </div>
  <p>
    <a
      href={SITE.instagram}
      target="_blank"
      rel="me noopener"
      class="btn-primary inline-flex min-h-12 items-center rounded-lg px-6 font-bold"
      style="background: var(--action); color: var(--on-action);"
    >
      دنبال کردن در اینستاگرام
    </a>
  </p>
</div>
