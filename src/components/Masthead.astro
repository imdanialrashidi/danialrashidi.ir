---
import { MAIN_NAV, SITE, SUPPORT_HREF } from "../config/site";
import BrandMark from "./BrandMark.astro";

const { path = "/" } = Astro.props as { path?: string };

function isActive(href: string, current: string) {
  if (href === "/") return current === "/";
  return current.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b"
  style="background: color-mix(in srgb, var(--canvas) 92%, transparent); backdrop-filter: blur(8px); border-color: var(--border);"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex min-h-11 min-w-11 items-center" aria-label="خانه‌ی دانیال رشیدی">
      <BrandMark size="header" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="ناوبری اصلی">
      {
        MAIN_NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href, path) ? "page" : undefined}
            class="quiet-link text-[0.95rem]"
            style={isActive(item.href, path) ? "color: var(--accent); text-decoration-color: var(--accent);" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={SUPPORT_HREF} class="text-[0.95rem]" style="color: var(--muted);">
        حمایت
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="تغییر تم روشن و تیره"
        class="grid min-h-11 min-w-11 place-items-center rounded-lg border px-3 text-sm"
        style="border-color: var(--border);"
      >
        <span aria-hidden="true">◐</span>
        <span data-theme-label class="sr-only">تیره</span>
      </button>
      <a
        href={SITE.telegram}
        target="_blank"
        rel="me noopener"
        class="hidden min-h-11 items-center rounded-lg px-4 text-sm font-bold sm:inline-flex"
        style="background: var(--action); color: var(--on-action);"
      >
        تلگرام
      </a>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="باز و بسته کردن منو"
        class="grid min-h-11 min-w-11 place-items-center rounded-lg border md:hidden"
        style="border-color: var(--border);"
      >
        <span aria-hidden="true" class="text-lg leading-none">≡</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t md:hidden" style="border-color: var(--border);">
    <nav class="mx-auto grid max-w-6xl gap-1 px-4 py-4" aria-label="ناوبری موبایل">
      {
        [...MAIN_NAV, { href: SUPPORT_HREF, label: "حمایت از پروژه‌ها" }].map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href, path) ? "page" : undefined}
            class="flex min-h-12 items-center justify-between rounded-lg px-3 text-base"
            style={isActive(item.href, path) ? "background: var(--surface); color: var(--accent);" : undefined}
          >
            <span>{item.label}</span>
            <span aria-hidden="true" style="color: var(--muted);">←</span>
          </a>
        ))
      }
      <a
        href={SITE.telegram}
        target="_blank"
        rel="me noopener"
        class="mt-2 flex min-h-12 items-center justify-center rounded-lg font-bold"
        style="background: var(--action); color: var(--on-action);"
      >
        گفت‌وگو در تلگرام
      </a>
    </nav>
  </div>
</header>
