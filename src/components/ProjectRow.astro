---
import type { CollectionEntry } from "astro:content";
import ProjectImage from "./ProjectImage.astro";

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props as Props;
const slug = project.id.replace(/\.mdx?$/, "");
const { data } = project;
const detailHref = `/پروژه‌ها/${slug}/`;
---

<article class="reveal grid gap-4 border-t py-6 sm:grid-cols-[190px_1fr_auto] sm:items-center sm:gap-6" style="border-color: var(--border);" aria-labelledby={`row-${slug}`}>
  <a href={detailHref} class="photo-frame row-thumb block overflow-hidden" tabindex="-1" aria-hidden="true">
    <ProjectImage image={data.image} imageAlt={data.imageAlt} imageWidth={data.imageWidth} imageHeight={data.imageHeight} title={data.title} faTitle={data.faTitle} monogram={data.monogram} />
  </a>
  <div>
    <h3 id={`row-${slug}`} class="text-lg font-bold">
      <a href={detailHref} class="quiet-link">{data.faTitle ?? data.title}</a>
      <span class="font-mono text-xs font-normal ltr" style="color: var(--muted);"> · {data.title}</span>
    </h3>
    <p class="mt-1 max-w-2xl text-[0.95rem]" style="color: var(--muted);">{data.description}</p>
    <p class="mt-2 font-mono text-xs" style="color: var(--muted);">{data.year} · {data.status}</p>
  </div>
  <p class="flex flex-wrap items-center gap-4">
    <a href={detailHref} class="inline-flex min-h-11 items-center text-[0.95rem] font-bold" style="color: var(--accent);">
      جزئیات ←
    </a>
    {
      data.liveUrl && (
        <a href={data.liveUrl} target="_blank" rel="noopener" class="quiet-link ltr inline-flex min-h-11 items-center font-mono text-xs">
          سایت زنده ↗
        </a>
      )
    }
  </p>
</article>
