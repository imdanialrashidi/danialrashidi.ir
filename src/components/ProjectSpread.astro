---
import type { CollectionEntry } from "astro:content";
import ProjectImage from "./ProjectImage.astro";

type Props = { project: CollectionEntry<"projects">; flip?: boolean };
const { project, flip = false } = Astro.props as Props;
const slug = project.id.replace(/\.mdx?$/, "");
const { data } = project;
const detailHref = `/پروژه‌ها/${slug}/`;
---

<article class="reveal grid gap-6 py-10 md:grid-cols-2 md:gap-10" aria-labelledby={`proj-${slug}`}>
  <a
    href={detailHref}
    class:list={["photo-frame block", flip && "md:order-2"]}
    tabindex="-1"
    aria-hidden="true"
  >
    <ProjectImage image={data.image} imageAlt={data.imageAlt} imageWidth={data.imageWidth} imageHeight={data.imageHeight} title={data.title} faTitle={data.faTitle} monogram={data.monogram} />
  </a>
  <div class:list={[flip && "md:order-1"]}>
    <p class="font-mono text-xs" style="color: var(--accent);">
      {data.year} · {data.status}
    </p>
    <h3 id={`proj-${slug}`} class="mt-2 text-2xl font-extrabold">
      <a href={detailHref} class="quiet-link">{data.faTitle ?? data.title}</a>
    </h3>
    <p class="mt-3 max-w-xl" style="color: var(--muted);">{data.description}</p>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="فناوری‌ها">
      {
        data.technologies.map((tech) => (
          <li class="rounded-md border px-2.5 py-1 text-xs" style="border-color: var(--border); color: var(--muted);">
            {tech}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 flex flex-wrap items-center gap-5">
      <a href={detailHref} class="inline-flex min-h-11 items-center font-bold" style="color: var(--accent);">
        خواندن درباره‌ی پروژه ←
      </a>
      {
        data.liveUrl && (
          <a href={data.liveUrl} target="_blank" rel="noopener" class="quiet-link ltr inline-flex min-h-11 items-center font-mono text-sm">
            {data.liveUrl.replace("https://", "")} ↗
          </a>
        )
      }
    </p>
  </div>
</article>
