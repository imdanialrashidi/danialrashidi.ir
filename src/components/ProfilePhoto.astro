---
import { PROFILE } from "../config/site";

/* قاب پرتره‌ی هیرو — عکس واقعی از PROFILE.photoSrc می‌آید.
   مالک: برای عوض کردن عکس، فایل تازه را در public/images/ بگذار و فقط
   photoSrc را در src/config/site.ts عوض کن. */
---

<figure class="portrait photo-frame reveal" style="--reveal-delay: 150ms;" aria-label="پرتره‌ی دانیال رشیدی">
  <div class="relative overflow-hidden" style="background: var(--surface);">
    <img
      src={PROFILE.photoSrc}
      srcset="/images/Danial_photo-480.webp 480w, /images/Danial_photo-855.webp 855w"
      sizes="(max-width: 640px) 480px, 855px"
      alt={PROFILE.photoAlt}
      width="855"
      height="1138"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="portrait-img block aspect-[4/5] w-full object-cover"
    />
    <span class="availability" role="status">
      <span aria-hidden="true" class="availability-dot"></span>
      {PROFILE.availability}
    </span>
  </div>
  <figcaption class="flex items-center justify-between gap-3 border-t px-5 py-4" style="border-color: var(--border);">
    <span class="text-sm font-bold">دانیال رشیدی · {PROFILE.location}</span>
    <span class="font-mono text-xs ltr" style="color: var(--muted);">est. danialrashidi.ir</span>
  </figcaption>
</figure>

<style>
  .portrait {
    transform: rotate(-0.6deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .portrait:hover {
    transform: rotate(0deg) translateY(-3px);
  }
  .portrait-img {
    transition: transform 500ms var(--ease-out);
  }
  .portrait:hover .portrait-img {
    transform: scale(1.015);
  }
  .availability {
    position: absolute;
    inset-inline-start: 1rem;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.4rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .availability-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: #2f9e44;
    box-shadow: 0 0 0 0 rgba(47, 158, 68, 0.5);
    animation: pulse-dot 2.2s ease-out infinite;
  }
  @keyframes pulse-dot {
    0% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0.45); }
    70% { box-shadow: 0 0 0 10px rgba(47, 158, 68, 0); }
    100% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0); }
  }
</style>
