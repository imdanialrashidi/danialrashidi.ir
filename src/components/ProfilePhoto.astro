---
import { PROFILE } from "../config/site";

/* قاب پرتره: پیش‌فرض عکس استودیویی PROFILE؛ هیروی خانه می‌تواند
   با src/srcset/alt/ابعاد خودش بازنویسی کند (فقط صفحه‌ی اصلی). */
type Props = { src?: string; srcset?: string; sizes?: string; alt?: string; width?: number; height?: number };
const {
  src = PROFILE.photoSrc,
  srcset = "/images/Danial_photo-480.webp 480w, /images/Danial_photo-855.webp 855w",
  sizes = "(max-width: 640px) 480px, 855px",
  alt = PROFILE.photoAlt,
  width = 855,
  height = 1138,
} = Astro.props as Props;
---

<figure class="portrait photo-frame" aria-label="پرتره‌ی دانیال رشیدی">
  <div class="overflow-hidden" style="background: var(--surface);">
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      alt={alt}
      width={width}
      height={height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="portrait-img block aspect-[4/5] w-full object-cover"
    />
  </div>
  <figcaption class="border-t px-5 py-4" style="border-color: var(--border);">
    <span class="block text-sm font-bold">دانیال رشیدی · {PROFILE.location}</span>
    <span class="mt-1 block text-sm" style="color: var(--muted);">{PROFILE.availability}</span>
  </figcaption>
</figure>

<style>
  /* A hand-placed print, tilted once and left alone. */
  .portrait {
    transform: rotate(-0.6deg);
  }
</style>
