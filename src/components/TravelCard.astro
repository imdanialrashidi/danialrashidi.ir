---
/* کارت سفر — قاب پرتره ۴/۵ برای عکس‌های عمودی مالک.
   هر عکس نقطه‌ی کانونی خودش را از imagePosition می‌گیرد تا چهره/سوژه
   در کراپ بریده نشود. بدون عکس: پنل تایپوگرافیک صادقانه. */
import { render, type CollectionEntry } from "astro:content";

type Props = { entry: CollectionEntry<"travels"> };
const { entry } = Astro.props as Props;
const key = entry.id.replace(/\.mdx?$/, "");
const { data } = entry;
const { Content } = await render(entry);
const alt = data.imageAlt ?? `سفر به ${data.destination}`;
const position = data.imagePosition ?? "50% 50%";
---

<article class="photo-frame travel-card" aria-labelledby={`travel-${key}`}>
  <div class="travel-img-wrap overflow-hidden" style="background: var(--surface);">
    {
      data.image ? (
        <img
          src={data.image}
          alt={alt}
          width={data.imageWidth}
          height={data.imageHeight}
          loading="lazy"
          decoding="async"
          class="travel-img block aspect-[4/5] w-full object-cover"
          style={`object-position: ${position};`}
        />
      ) : (
        <div class="grid aspect-[4/5] place-items-center px-6 text-center">
          <div>
            <p class="panel-mono text-6xl" style="color: var(--action);">{data.monogram}</p>
            <p class="mt-2 font-bold">{data.destination}</p>
            <p class="font-mono text-xs" style="color: var(--muted);">{data.date}</p>
          </div>
        </div>
      )
    }
  </div>
  <div class="border-t p-5" style="border-color: var(--border);">
    <h3 id={`travel-${key}`} class="font-bold">{data.destination}</h3>
    <p class="mt-1 font-mono text-xs" style="color: var(--muted);">{data.date}</p>
    <p class="mt-2 text-sm" style="color: var(--muted);">{data.description}</p>
    <div class="travel-note mt-2 text-sm" style="color: var(--muted);">
      <Content />
    </div>
    {
      data.instagramUrl && (
        <a href={data.instagramUrl} target="_blank" rel="noopener" class="quiet-link mt-3 inline-flex min-h-11 items-center text-sm">
          دیدن عکس‌ها در اینستاگرام ↗
        </a>
      )
    }
  </div>
</article>

<style>
  .travel-img {
    transition: transform 500ms var(--ease-out);
  }
  .travel-card:hover .travel-img {
    transform: scale(1.04);
  }
  .travel-note :global(p) {
    margin: 0;
  }
  .travel-note :global(p + p) {
    margin-top: 0.5rem;
  }
</style>
