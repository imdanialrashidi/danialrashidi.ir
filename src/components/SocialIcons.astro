---
import { SOCIALS, type SocialId } from "../config/site";
import SocialIcon from "./SocialIcon.astro";

type Props = {
  ids?: SocialId[];
  layout?: "row" | "list";
  size?: "md" | "lg";
};

const { ids, layout = "row", size = "md" } = Astro.props as Props;
const links = ids ? SOCIALS.filter((s) => ids.includes(s.id)) : SOCIALS;
const box = size === "lg" ? "min-h-12 min-w-12" : "min-h-11 min-w-11";
---

<ul
  class:list={["m-0 list-none p-0", layout === "row" ? "flex flex-wrap items-center gap-2" : "grid gap-1"]}
  aria-label="شبکه‌های اجتماعی دانیال رشیدی"
>
  {
    links.map((s) => (
      <li class="flex">
        <a
          href={s.href}
          target={s.href.startsWith("mailto:") ? undefined : "_blank"}
          rel="me noopener"
          aria-label={`${s.label} — ${s.handle}`}
          title={`${s.label} — ${s.handle}`}
          class:list={[
            "social-icon group inline-flex items-center gap-2 rounded-lg border px-3",
            box,
            layout === "list" && "w-full",
          ]}
          style="border-color: var(--border);"
        >
          <SocialIcon id={s.id} class="size-5 shrink-0" />
          <span class:list={["text-sm font-bold", layout === "row" ? "hidden lg:inline" : ""]}>{s.label}</span>
          {layout === "list" && (
            <span class="ltr font-mono text-xs" style="color: var(--muted);">{s.handle}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-icon {
    color: var(--ink);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .social-icon:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }
  .social-icon:active {
    transform: translateY(0);
  }
</style>
