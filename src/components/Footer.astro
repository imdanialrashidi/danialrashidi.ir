---
import { SOCIALS, SITE, PROFILE } from "../config/site";
import BrandMark from "./BrandMark.astro";
---

<footer class="section-rule mt-24" aria-label="پانوشت">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" aria-label="خانه‌ی دانیال رشیدی" class="inline-flex min-h-11 items-center">
          <BrandMark size="footer" />
        </a>
        <p class="mt-2 max-w-md text-[0.95rem]" style="color: var(--muted);">
          این سایت خانه‌ی شخصی من است؛ جایی که پروژه‌ها، سفرها و یادداشت‌ها را نگه می‌دارم.
          {PROFILE.nowDoing}.
        </p>
        <div class="mt-5">
          <div class="flex flex-wrap gap-2" role="list" aria-label="شبکه‌های اجتماعی">
            {
              SOCIALS.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                  rel="me noopener"
                  role="listitem"
                  aria-label={`${s.label} — ${s.handle}`}
                  class="social-icon inline-grid min-h-11 min-w-11 place-items-center rounded-lg border"
                  style="border-color: var(--border);"
                  title={`${s.label} — ${s.handle}`}
                >
                  <span aria-hidden="true" class="grid size-5 place-items-center">
                    {s.id === "github" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M9 19c-4 1.5-4-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1-.5 2V21"/></svg>
                    )}
                    {s.id === "telegram" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                    )}
                    {s.id === "instagram" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                    )}
                    {s.id === "email" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                    )}
                    {s.id === "x" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="size-5"><path d="M4 4l16 16M20 4L4 20"/></svg>
                    )}
                    {s.id === "website" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    )}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
        <p class="ltr mt-4 font-mono text-sm" style="color: var(--muted);">
          <a class="quiet-link" href={SITE.englishSite} target="_blank" rel="noopener">{SITE.englishLabel}</a>
          <span aria-hidden="true"> · </span>
          <a class="quiet-link" href={SITE.telegram} target="_blank" rel="me noopener">{SITE.telegramHandle}</a>
        </p>
      </div>
      <nav aria-label="دسترسی سریع">
        <p class="text-sm font-bold" style="color: var(--muted);">بخش‌ها</p>
        <ul class="mt-3 space-y-2">
          <li><a class="quiet-link" href="/درباره/">درباره</a></li>
          <li><a class="quiet-link" href="/پروژه‌ها/">پروژه‌ها</a></li>
          <li><a class="quiet-link" href="/سفرها/">سفرها</a></li>
          <li><a class="quiet-link" href="/حمایت/">حمایت از پروژه‌ها</a></li>
          <li><a class="quiet-link" href="/ارتباط/">ارتباط</a></li>
        </ul>
      </nav>
      <div>
        <p class="text-sm font-bold" style="color: var(--muted);">ارتباط مستقیم</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a class="quiet-link ltr font-mono text-sm" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li>
            <a class="quiet-link ltr font-mono text-sm" href={SITE.github} target="_blank" rel="me noopener">github.com/{SITE.githubHandle}</a>
          </li>
          <li>
            <a class="quiet-link" href={SITE.telegram} target="_blank" rel="me noopener">تلگرام — {SITE.telegramHandle}</a>
          </li>
          <li>
            <a class="quiet-link" href={SITE.instagram} target="_blank" rel="me noopener">اینستاگرام — {SITE.instagramHandle}</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--border); color: var(--muted);">
      <p>© ۱۴۰۵ دانیال رشیدی — نوشته و ساخته‌شده با دقت.</p>
      <p class="font-mono text-xs ltr">danialrashidi.ir · v1</p>
    </div>
  </div>
</footer>

<style>
  .social-icon {
    color: var(--ink);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .social-icon:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
