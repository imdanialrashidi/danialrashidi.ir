---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectSpread from "../../components/ProjectSpread.astro";
import ProjectRow from "../../components/ProjectRow.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Base path="/پروژه‌ها/" title="پروژه‌های دانیال رشیدی" description="پروژه‌های دانیال رشیدی: نوونو، فروشگاه‌های اینترنتی و سایت‌های شرکتی و آموزشی؛ هرکدام با اسکرین‌شات واقعی، شرح کار و نشانی زنده.">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="pb-8 pt-12 md:pt-16" aria-labelledby="projects-title">
      <p class="font-mono text-sm" style="color: var(--accent);">۰۵ پروژه · ۱ جدی، ۴ منتخب</p>
      <h1 id="projects-title" class="mt-4 text-4xl font-extrabold sm:text-5xl">پروژه‌ها</h1>
      <p class="mt-4 max-w-2xl" style="color: var(--muted);">
        کاری که عمیق جلو می‌برم اول است؛ بقیه پروفایل‌های کوتاه و صادقانه‌اند.
        هر پنج‌تا اسکرین‌شات واقعی دارند — بدون ماکاپ تزیینی.
      </p>
    </section>

    <section aria-label="کارهای جدی">
      <div class="section-rule pt-6">
        <p class="font-mono text-sm" style="color: var(--accent);">ویژه — کار عمیق</p>
      </div>
      <div class="divide-y" style="border-color: var(--border);">
        {featured.map((project, i) => <ProjectSpread project={project} flip={i % 2 === 1} />)}
      </div>
    </section>

    <section class="pb-10" aria-label="کارهای منتخب">
      <div class="section-rule pt-6">
        <p class="font-mono text-sm" style="color: var(--accent);">منتخب — پروفایل کوتاه</p>
      </div>
      <div>
        {rest.map((project) => <ProjectRow project={project} />)}
      </div>
    </section>
  </div>
</Base>
