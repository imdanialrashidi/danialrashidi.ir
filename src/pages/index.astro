---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Signature from "../components/Signature.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectSpread from "../components/ProjectSpread.astro";
import ProjectRow from "../components/ProjectRow.astro";
import TravelCard from "../components/TravelCard.astro";
import InstagramBand from "../components/InstagramBand.astro";
import ProfilePhoto from "../components/ProfilePhoto.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { SITE, PROFILE } from "../config/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const compact = projects.filter((p) => !p.data.featured);
const travels = (await getCollection("travels")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<Base
  path="/"
  title="خانه"
  description="دانیال رشیدی — سازنده‌ی نرم‌افزار و محصول؛ وب‌اپ، فروشگاه اینترنتی و ابزار کاربردی، از ایده‌ی مبهم تا سیستمِ در حال کار."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {/* HERO */}
    <section class="grid gap-10 pb-16 pt-12 md:grid-cols-[7fr_5fr] md:items-center md:pt-20" aria-labelledby="hero-title">
      <div>
        <p class="hero-enter font-mono text-sm" style="color: var(--accent); --reveal-delay: 0ms;">۰ · خانه‌ی شخصی · {PROFILE.location}</p>
        <h1 id="hero-title" class="sr-only">دانیال رشیدی — خانه‌ی شخصی</h1>
        <div class="hero-enter mt-4" style="--reveal-delay: 80ms;">
          <Signature size="hero" />
        </div>
        <p class="hero-enter mt-6 max-w-xl text-lg leading-9" style="--reveal-delay: 160ms;">
          سلام، من <strong>دانیال رشیدی</strong> هستم. نرم‌افزار و محصول می‌سازم —
          از ایده‌ی مبهم تا سیستمی که واقعاً کار کند. این‌جا خانه‌ی شخصی من است:
          پروژه‌هایی که جدی گرفته‌ام، سفرهایی که دوستشان دارم، و راهی برای حرف زدن.
        </p>
        <p class="hero-enter mt-4 flex flex-wrap gap-5" style="--reveal-delay: 240ms;">
          <a
            href="/پروژه‌ها/"
            class="btn-primary inline-flex min-h-12 items-center rounded-lg px-7 font-bold"
            style="background: var(--action); color: var(--on-action);"
          >
            دیدن پروژه‌ها
          </a>
          <a href="/درباره/" class="quiet-link inline-flex min-h-12 items-center font-bold">
            بیشتر درباره‌ی من ←
          </a>
        </p>
        <p class="hero-enter mt-6 max-w-xl border-s-2 ps-4 text-[0.95rem]" style="border-color: var(--accent); color: var(--muted); --reveal-delay: 320ms;">
          <strong style="color: var(--ink);">الان:</strong> {PROFILE.nowDoing} —
          ساکن {PROFILE.location}. بیرون از ویرایشگر: {PROFILE.interests.join("، ")}.
          مسیرش: <a class="quiet-link" href="/پروژه‌ها/noveno/">نوونو</a>.
        </p>
        <div class="hero-enter mt-6" style="--reveal-delay: 400ms;">
          <SocialIcons />
          <p class="mt-3 font-mono text-xs ltr" style="color: var(--muted);">
            {SITE.telegramHandle} · github.com/{SITE.githubHandle}
          </p>
        </div>
      </div>

      <div class="grid gap-5">
        <ProfilePhoto />
        <div class="hero-enter rounded-xl border p-5" style="border-color: var(--border); background: var(--surface); --reveal-delay: 260ms;">
          <p class="text-sm font-bold">چه کمکی از دستم برمی‌آید</p>
          <ul class="mt-3 space-y-2 text-[0.95rem]" style="color: var(--muted);">
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">—</span> وب‌اپ و ابزار محصولی که واقعاً استفاده شود</li>
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">—</span> سایت فروشگاهی و شرکتی تمیز و سریع</li>
            <li class="flex gap-2"><span aria-hidden="true" style="color: var(--accent);">—</span> اتوماسیون کارهای تکراری و اتصال سیستم‌ها</li>
          </ul>
          <p class="mt-4">
            <a href="/ارتباط/" class="quiet-link inline-flex min-h-11 items-center text-sm font-bold">
              برای پروژه پیام بده ←
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* SELECTED PROJECTS */}
    <section class="pb-4" aria-labelledby="selected-projects">
      <span id="selected-projects" class="sr-only">پروژه‌های منتخب</span>
      <SectionHeading
        index="۰۱"
        title="پروژه‌های منتخب"
        note="کاری که این روزها جدی گرفته‌ام جلوتر؛ بقیه، کوتاه و صادقانه — هرکدام با اسکرین‌شات واقعی خودش."
        href="/پروژه‌ها/"
        linkLabel="همه‌ی پروژه‌ها"
      />
      <div class="divide-y" style="border-color: var(--border);">
        {featured.map((project, i) => <ProjectSpread project={project} flip={i % 2 === 1} />)}
      </div>
      <div class="mt-2">
        {compact.map((project) => <ProjectRow project={project} />)}
      </div>
    </section>

    {/* ABOUT SNAPSHOT */}
    <section class="py-14" aria-labelledby="about-snapshot">
      <span id="about-snapshot" class="sr-only">نگاهی به من</span>
      <SectionHeading index="۰۲" title="درباره، کوتاه" href="/درباره/" linkLabel="کاملش را بخوانید" />
      <div class="reveal grid gap-8 py-8 md:grid-cols-[5fr_7fr]">
        <p class="panel-mono text-2xl leading-relaxed">
          «ایده وقتی ارزش دارد که به چیزی قابل استفاده تبدیل شود.»
        </p>
        <div>
          <p class="max-w-2xl">
            من دانیال هستم؛ وب‌اپ، ابزارهای کاربردی و سیستم‌هایی می‌سازم که کار تکراری را کم کنند.
            از هوش مصنوعی هم استفاده می‌کنم، ولی تصمیم و مسئولیت راستی‌آزمایی با خودم است.
            این روزها تمرکزم روی بهتر شدن در مهندسی محصول و جلو بردن نوونو است.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="علاقه‌ها">
            {
              PROFILE.interests.map((tag) => (
                <li class="rounded-md border px-2.5 py-1 text-xs" style="border-color: var(--border); color: var(--muted);">
                  {tag}
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm" style="color: var(--muted);">
            {PROFILE.availability} · {PROFILE.availabilityNote} — <a class="quiet-link" href="/درباره/">مسیرم را بخوانید</a>
          </p>
          <p class="mt-3" style="color: var(--muted);">— دانیال</p>
        </div>
      </div>
    </section>

    {/* TRAVEL PREVIEW */}
    <section class="pb-14" aria-labelledby="travel-preview">
      <span id="travel-preview" class="sr-only">سفرها</span>
      <SectionHeading
        index="۰۳"
        title="سفرها و قاب‌ها"
        note="یادداشت‌های کوتاه سفر با قاب خودش؛ عکس‌های کامل در اینستاگرام زندگی می‌کنند."
        href="/سفرها/"
        linkLabel="همه‌ی سفرها"
      />
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {travels.map((entry) => <TravelCard entry={entry} />)}
      </div>
    </section>

    {/* INSTAGRAM */}
    <section aria-label="اینستاگرام">
      <SectionHeading index="۰۴" title="اینستاگرام" note="قاب‌های سفر و روزمره، بدون امبد سنگین." />
      <InstagramBand />
    </section>

    {/* SUPPORT TEASER */}
    <section class="py-14" aria-labelledby="support-teaser">
      <span id="support-teaser" class="sr-only">حمایت</span>
      <SectionHeading index="۰۵" title="حمایت از پروژه‌ها" href="/حمایت/" linkLabel="صفحه‌ی حمایت" />
      <div class="reveal mt-6 grid gap-6 md:grid-cols-[7fr_5fr] md:items-center">
        <p class="max-w-2xl" style="color: var(--muted);">
          این پروژه‌ها را مستقل و با هزینه‌ی شخصی جلو می‌برم. اگر کاری به دردتان خورد و خواستید
          در ادامه‌ی ساخت و نگه‌داری‌اش سهیم باشید، راهش این‌جاست — بی‌سر و صدا و بدون اصرار.
        </p>
        <p>
          <a href="/حمایت/" class="quiet-link inline-flex min-h-11 items-center font-bold">
            چطور می‌شود حمایت کرد ←
          </a>
        </p>
      </div>
    </section>

    {/* CONTACT */}
    <section class="pb-4" aria-labelledby="contact">
      <span id="contact" class="sr-only">ارتباط</span>
      <SectionHeading index="۰۶" title="ارتباط" href="/ارتباط/" linkLabel="صفحه‌ی ارتباط" />
      <div class="reveal py-8">
        <p class="text-lg">برای کار، همکاری، یا فقط سلام:</p>
        <p class="mt-2">
          <a href={`mailto:${SITE.email}`} class="quiet-link ltr font-mono text-xl font-bold sm:text-2xl">
            {SITE.email}
          </a>
        </p>
        <div class="mt-5">
          <SocialIcons ids={["telegram", "github", "instagram", "email"]} />
        </div>
        <p class="mt-4" style="color: var(--muted);">
          سریع‌ترین راه ایمیل است؛ تلگرام هم هست:
          <a class="quiet-link ltr font-mono text-sm" href={SITE.telegram} target="_blank" rel="me noopener"> {SITE.telegramHandle}</a>
          <span> — {PROFILE.availabilityNote}.</span>
        </p>
      </div>
    </section>
  </div>
</Base>
