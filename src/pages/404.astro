---
import Base from "../layouts/Base.astro";
---

<Base path="/404/" title="صفحه پیدا نشد" description="این صفحه وجود ندارد — برگردید به خانه‌ی دانیال رشیدی." noindex>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm" style="color: var(--accent);">۴۰۴</p>
    <h1 class="mt-4 text-4xl font-extrabold">این مسیر به جایی نمی‌رسد</h1>
    <p class="mt-4 max-w-xl" style="color: var(--muted);">
      نشانی‌ای که باز کردید وجود ندارد. شاید اشتباه تایپ شده یا صفحه جابه‌جا شده است.
    </p>
    <p class="mt-6 flex flex-wrap gap-5">
      <a href="/" class="inline-flex min-h-12 items-center rounded-lg px-7 font-bold" style="background: var(--action); color: var(--on-action);">
        برگشت به خانه
      </a>
      <a href="/پروژه‌ها/" class="quiet-link inline-flex min-h-12 items-center font-bold">دیدن پروژه‌ها ←</a>
    </p>
  </div>
</Base>
